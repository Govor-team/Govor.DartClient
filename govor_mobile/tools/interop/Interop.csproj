<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <ServerRoot Condition="'$(ServerRoot)' == ''">../../../../Govor</ServerRoot>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="jose-jwt" Version="5.3.0" />
    <PackageReference Include="srp" Version="1.0.7" />
    <Compile Include="$(ServerRoot)/Govor.Application/E2ee/E2eeProtocol.cs" Link="E2eeProtocol.cs" />
    <Compile Include="$(ServerRoot)/Govor.Application/E2ee/E2eeRecoveryProtocol.cs" Link="E2eeRecoveryProtocol.cs" />
    <Compile Include="$(ServerRoot)/Govor.Application/Authentication/PasswordProtocol.cs" Link="PasswordProtocol.cs" />
  </ItemGroup>
</Project>
